<policies>
  <inbound>
    <base />

    <validate-azure-ad-token tenant-id="{{entra-tenant-id}}" header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Invalid or missing Entra token.">
      <audiences>
        <audience>{{expected-audience}}</audience>
      </audiences>
      <required-claims>
        <claim name="oid" />
        <claim name="tid" />
        <claim name="roles" match="any">
          <value>{{required-app-role}}</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>

    <set-variable name="callerObjectId" value="@(context.Principal?.Claims?.FirstOrDefault(c => c.Type == &quot;oid&quot;)?.Value ?? &quot;anonymous&quot;)" />
    <set-variable name="callerTenantId" value="@(context.Principal?.Claims?.FirstOrDefault(c => c.Type == &quot;tid&quot;)?.Value ?? &quot;unknown&quot;)" />
    <set-variable name="callerKey" value="@((string)context.Variables[&quot;callerTenantId&quot;] + &quot;:&quot; + (string)context.Variables[&quot;callerObjectId&quot;])" />

    <rate-limit-by-key calls="{{per-user-rate-limit}}" renewal-period="60" counter-key="@((string)context.Variables[&quot;callerKey&quot;])" />
    <quota-by-key calls="{{per-user-hourly-quota}}" renewal-period="3600" counter-key="@((string)context.Variables[&quot;callerKey&quot;])" />
    <llm-token-limit counter-key="@((string)context.Variables[&quot;callerKey&quot;])" tokens-per-minute="{{per-user-token-limit}}" estimate-prompt-tokens="true" remaining-tokens-header-name="x-remaining-user-tokens" />

    <set-header name="Authorization" exists-action="delete" />
    <set-header name="x-api-key" exists-action="delete" />
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="x-functions-key" exists-action="delete" />
    <set-query-parameter name="subscription-key" exists-action="delete" />
    <set-query-parameter name="api-key" exists-action="delete" />

    <trace source="claude-gateway" severity="information">
      <message>@($"requestId={context.RequestId};tenant={context.Variables["callerTenantId"]};user={context.Variables["callerObjectId"]};operation={context.Operation.Id}")</message>
    </trace>

    <set-backend-service backend-id="foundry-backend" />
    <authentication-managed-identity resource="https://ai.azure.com" output-token-variable-name="backendToken" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["backendToken"])</value>
    </set-header>
  </inbound>

  <backend>
    <forward-request buffer-response="false" />
  </backend>

  <outbound>
    <base />
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
